# Which Backblaze quarters to use. Each is about 1 GB zipped.
QUARTERS=Q1_2024,Q2_2024,Q3_2024

# Local database from docker-compose (default)
DATABASE_URL=postgresql+psycopg://drives:drives@localhost:5432/drives

# Azure Database for PostgreSQL instead (fill in your server name and password):
# DATABASE_URL=postgresql+psycopg://drivesadmin:YOUR_PASSWORD@YOUR-SERVER.postgres.database.azure.com:5432/postgres?sslmode=require

# Azure Blob Storage for the raw data lake (optional)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_CONTAINER=drive-stats

# Spark memory. 2g works on an 8 GB laptop; raise it if you have more RAM.
SPARK_DRIVER_MEMORY=2g
